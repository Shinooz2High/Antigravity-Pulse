# Antigravity Pulse — Environment Configuration
AGY_HOST=0.0.0.0
AGY_PORT=8765

# Optional 6-digit PIN override (auto-generated and saved to backend/data/settings.json if blank)
AGY_BRIDGE_PIN=

# Gemini API / Antigravity SDK configuration (can also be configured in the mobile Settings UI)
GEMINI_API_KEY=
GOOGLE_GENAI_USE_VERTEXAI=false
GOOGLE_CLOUD_PROJECT=
GOOGLE_CLOUD_LOCATION=us-central1
AGY_MODEL=

# Optional overrides for local brain monitor and default workspace
AGY_BRAIN_DIR=
AGY_DEFAULT_PROJECT=
